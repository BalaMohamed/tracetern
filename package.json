{
  "name": "tracetern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && bash scripts/with-postgres.sh node --test dist/test/*.test.js",
    "test:library": "npm run build && node --test dist/test/library/*.test.js",
    "tracetern": "npm run build --silent && node dist/src/cli.js",
    "demo": "npm run build --silent && bash scripts/with-postgres.sh node dist/src/cli.js",
    "view": "npm run build --silent && node dist/src/viewer.js"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
